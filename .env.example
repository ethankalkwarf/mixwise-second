# Site
NEXT_PUBLIC_SITE_URL=https://www.getmixwise.com

# Learn hub — public by default. Set to false to hide from nav, sitemap, and robots.
# NEXT_PUBLIC_LEARN_PUBLIC=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sanity Studio (optional; public site content lives in Supabase)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Email (Resend)
RESEND_API_KEY=

# Product analytics (PostHog) — web + Capacitor native WebView
# Create a project at https://posthog.com and paste the project API key.
# Clarity remains for web session replay only; PostHog is the event/funnel layer.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Resend webhook (opens/clicks) — set in Resend dashboard → Webhooks
# URL: https://www.getmixwise.com/api/webhooks/resend?secret=...
RESEND_WEBHOOK_SECRET=

# Native Google Sign-In (Capacitor) — iOS OAuth client from Google Cloud Console
# Create type "iOS" with bundle ID com.getmixwise.app, then paste Client ID here.
# Also add the reversed client ID (iOS URL scheme) to ios/App/App/Info.plist.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=200787084084-p94m1d02kjnjgdc7o56ggimo4rg1c6ns.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_IOS_CLIENT_ID=200787084084-kq7af34h07boo7mntltcqpa09uve1ce9.apps.googleusercontent.com

# Meta / Facebook App ID — required for Instagram & Facebook Sharing to Stories
# Create an app at https://developers.facebook.com and paste the App ID here.
NEXT_PUBLIC_FACEBOOK_APP_ID=

# Optional App Store listing URL (shown on public bar join CTA when set)
NEXT_PUBLIC_IOS_APP_STORE_URL=

# Google Search Console sync (optional; off-site cocktail query demand)
# 1) Add property for getmixwise.com in Search Console
# 2) Create a Google Cloud service account, download JSON key
# 3) Add the service account email as a Search Console user (Full)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GSC_SITE_URL=sc-domain:getmixwise.com

# Vercel Blob — public catalog delivery (scripts/migrateCatalogImagesToBlob.ts)
BLOB_READ_WRITE_TOKEN=

# Internal / admin API auth
CRON_SECRET=
ADMIN_SECRET=
EMAIL_TEST_SECRET=
