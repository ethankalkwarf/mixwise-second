# Site
NEXT_PUBLIC_SITE_URL=https://www.getmixwise.com

# Learn hub — public by default. Set to false to hide from nav, sitemap, and robots.
# NEXT_PUBLIC_LEARN_PUBLIC=false

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Sanity Studio (optional; public site content lives in Supabase)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Email (Resend)
RESEND_API_KEY=

# Vercel Blob — public catalog delivery (scripts/migrateCatalogImagesToBlob.ts)
BLOB_READ_WRITE_TOKEN=

# Internal / admin API auth
CRON_SECRET=
ADMIN_SECRET=
EMAIL_TEST_SECRET=
