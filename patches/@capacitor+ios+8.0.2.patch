+    /// True for Google account / OAuth hosts that must never be handed to Safari.app.
+    private static func isGoogleOAuthURL(_ url: URL) -> Bool {
+        guard let host = url.host?.lowercased() else { return false }
+        if host == "accounts.google.com" || host.hasSuffix(".accounts.google.com") {
+            return true
+        }
+        if host == "oauth2.googleapis.com" ||
+            (host.hasSuffix(".googleapis.com") && url.path.contains("oauth")) {
+            return true
+        }
+        if host.contains("googleusercontent.com") {
+            return true
+        }
+        if host == "www.google.com" || host == "google.com" {
+            return url.path.contains("/o/oauth") || url.path.contains("/oauth")
+        }
+        return false
+    }
